/* 1. ИЗБИРАМЕ ОФИЦИАЛНИЯ ЛАЙАУТ ЗА ZMK STUDIO */
/ {
    chosen {
        zmk,physical-layout = &layout_60_ansi;
    };
};

/* 2. ОБВЪРЗВАМЕ ГО С ВАШАТА V1 МАТРИЦА */
&layout_60_ansi {
    transform = <&v1_transform>;
};

/* 3. ДОБАВЯМЕ ЛИПСВАЩИЯ ПИН В МАСИВА НА ДРАЙВЕРА (Премахва Skew-а и пуска стрелката) */
&kscan0 {
    col-gpios
        = <&gpio0 27 GPIO_ACTIVE_HIGH>
        , <&gpio0 26 GPIO_ACTIVE_HIGH>
        , <&gpio0 6  GPIO_ACTIVE_HIGH>
        , <&gpio0 8  GPIO_ACTIVE_HIGH>
        , <&gpio1 9  GPIO_ACTIVE_HIGH>
        , <&gpio0 12 GPIO_ACTIVE_HIGH>
        , <&gpio0 17 GPIO_ACTIVE_HIGH>
        , <&gpio0 13 GPIO_ACTIVE_HIGH>
        , <&gpio0 15 GPIO_ACTIVE_HIGH>
        , <&gpio0 24 GPIO_ACTIVE_HIGH>
        , <&gpio0 22 GPIO_ACTIVE_HIGH>
        , <&gpio0 20 GPIO_ACTIVE_HIGH>
        , <&gpio0 19 GPIO_ACTIVE_HIGH>
        , <&gpio0 4  GPIO_ACTIVE_HIGH>
        , <&gpio0 2  GPIO_ACTIVE_HIGH> // Инжектираме 15-тия пин за дясната стрелка
        ;
};

/* 4. НАЛАГАМЕ ВАШАТА ТОЧНА ОРИГИНАЛНА МАТРИЦА */
/ {
    v1_transform: v1_transform {
        compatible = "zmk,matrix-transform";
        columns = <15>; 
        rows = <5>;    
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12)     RC(0,13) RC(2,13)
            RC(1,0)   RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12)   RC(1,13)
            RC(2,0)     RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)          RC(2,12)
            RC(3,0)       RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)  RC(3,10)               RC(3,11)
            RC(4,0)   RC(4,1)   RC(4,2)                      RC(4,5)                     RC(4,8)   RC(4,9)    RC(4,10)     RC(4,11)
        >;
    };
};
