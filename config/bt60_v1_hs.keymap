#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------
            // | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BKSP   |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   "|"    |
            // | CAPS  |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER    |
            // |  SHIFT  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |      SHIFT       |
            // |  CTL  |  WIN  |  ALT  |                     SPACE               | ALT | WIN | MO(1) | CTL |
            // ------------------------------------------------------------------------------------------
            bindings = <
                &kp ESC  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSLH
                &kp CLCK  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT           &kp ENTER
                &kp LSHFT        &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH    &kp RSHFT
                &kp LCTRL &kp LGUI &kp LALT               &kp SPACE                     &kp RALT &kp RGUI &mo 1 &kp RCTRL
            >;
        };

        raise {
            // ------------------------------------------------------------------------------------------
            // | BT CLR | F1  | F2  | F3  | F4  | F5  | F6  | F7  | F8  | F9  | F10 | F11 | F12 |  DEL    |
            // |  TAB    |     |  UP |     |     |     |     |     |     |     |     |     |     |        |
            // |          | LFT | DWN | RGT |     |     |     |     |     |     |     |     |            |
            // |    SHIFT    |     |     |     |     |     |     |     |     |     |     |     |  RESET   |
            // |       |      |      |                                           |     |     |       |     |
            // ------------------------------------------------------------------------------------------
            bindings = <
                &bt BT_CLR &kp F1    &kp F2    &kp F3    &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp DEL
                &trans     &trans    &kp UP    &trans    &trans &trans &trans &trans &trans &trans &trans  &trans  &trans  &trans
                &trans     &kp LEFT  &kp DOWN  &kp RIGHT &trans &trans &trans &trans &trans &trans &trans  &trans          &trans
                &trans               &trans    &trans    &trans &trans &trans &trans &trans &trans &trans  &trans          &sys_reset
                &trans     &trans    &trans                  &trans                     &trans &trans &trans          &trans
            >;
        };

        media_bt_layer {
            // Layer 2: Активира се от бутона вдясно от Space. Съдържа Медия, Bluetooth профили и Reset
            bindings = <
                &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans     &trans       &trans       &trans &trans
                &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans     &trans       &trans              &trans
                &trans                    &trans       &trans       &trans       &trans       &trans &trans &trans &kp C_PREV &kp C_PP     &kp C_NEXT          &trans
                &trans       &trans       &trans                                 &trans                             &trans     &trans       &trans              &sys_reset
            >;
        };
    };
};


#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Layer 0: Основен
            // &mo 1 на мястото на Caps Lock активира Слой 1 (F1-F12) само при задържане
            // &mo 2 на мястото на клавиша вдясно от Space активира Слой 2 (Media/Bluetooth)
            bindings = <
                &kp ESC   &kp N1   &kp N2   &kp N3   &kp N4 &kp N5 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q    &kp W    &kp E    &kp R  &kp T  &kp Y  &kp U  &kp I     &kp O    &kp P    &kp LBKT  &kp RBKT  &kp BSLH
                &mo 1     &kp A    &kp S    &kp D    &kp F  &kp G  &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT             &kp ENTER
                &kp LSHFT          &kp Z    &kp X    &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH            &kp RSHFT
                &kp LCTRL &kp LGUI &kp LALT                 &kp SPACE                      &mo 2    &kp RGUI &trans    &kp RCTRL
            >;
        };

        f_layer {
            // Layer 1: Активира се при задържане на бившия Caps Lock. Съдържа F1-F12
            bindings = <
                &trans &kp F1   &kp F2   &kp F3   &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp DEL
                &trans &trans   &kp UP   &trans   &trans &trans &trans &trans &trans &trans &trans  &trans  &trans  &trans
                &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans &trans &trans &trans &trans &trans  &trans          &trans
                &trans          &trans   &trans   &trans &trans &trans &trans &trans &trans &trans  &trans          &trans
                &trans &trans   &trans                    &trans                      &trans &trans  &trans          &trans
            >;
        };


    };
};

