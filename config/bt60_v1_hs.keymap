#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";
            // ------------------------------------------------------------------------------------------
            // | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BKSP   |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   "|"    |
            // | CAPS  |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER    |
            // |  SHIFT  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |      SHIFT       |
            // |  CTL  |  WIN  |  ALT  |                     SPACE               | ALT | WIN | MO(1) | CTL |
            // ------------------------------------------------------------------------------------------
        default_layer { bindings = < &kp ESC   &kp N1   &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9    &kp N0   &kp MINUS &kp EQUAL &kp BSPC
                                     &kp TAB   &kp Q    &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O     &kp P    &kp LBKT  &kp RBKT  &kp BSLH
                                     &mo 1     &kp A    &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L     &kp SEMI &kp SQT             &kp ENTER
                                     &kp LSHFT          &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH  &kp UP
                                     &kp LCTRL &kp LGUI &kp LALT               &kp SPACE                                    &mo 2     &kp LEFT &kp DOWN &kp RIGHT  >;
        };

        raise         { bindings = < &kp GRAVE &kp F1          &kp F2    &kp F3    &kp F4    &kp F5    &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans
                                     &kp C_PP  &kp FSLH        &kp UP    &kp DEL   &kp HOME  &kp PG_UP &trans &trans &trans &trans &trans  &trans  &trans  &trans
                                     &trans    &kp LEFT        &kp DOWN  &kp RIGHT &kp END   &kp PG_DN &trans &trans &trans &trans &trans  &trans          &trans
                                     &kp LSHFT &kp LBKT        &kp RBKT  &kp COMMA &kp DOT   &trans    &trans &trans &trans &trans &trans          &trans
                                     &kp ENTER &kp PRINTSCREEN &trans                &kp BSPC                                       &trans  &trans &trans  &trans  >;
        };

        media_bt      { bindings = < &bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &sys_reset   &bootloader
                                     &bt BT_CLR_ALL &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans     &trans       &trans       &trans       &trans
                                     &trans         &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans     &trans       &trans                    &out OUT_TOG
                                     &trans         &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &kp C_MUTE &kp C_PP     &kp C_VOL_UP
                                     &bt BT_CLR_ALL &trans       &trans                  &trans                                                      &trans       &kp C_PREV   &kp C_VOL_DN &kp C_NEXT  >;
        };
    };
};
